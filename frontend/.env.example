# ─────────────────────────────────────────────────────────────────────────────
# StudyOS frontend configuration
#
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser by Vite.
# Values are read through a single config module (src/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the StudyOS backend API (no trailing slash).
# Development default (when unset): http://localhost:8000
# Example for production: https://api.studyos.com
VITE_API_URL=http://localhost:8000
