# ─────────────────────────────────────────────────────────────────────────────
# StudyOS backend configuration
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# Every value below is optional in local development (sensible defaults are
# baked in). Variables marked REQUIRED IN PRODUCTION must be set explicitly when
# ENVIRONMENT is `staging` or `production`, or startup will fail fast.
#
# All values are loaded through a single typed Settings object
# (app/core/config.py). Do not add scattered os.getenv() calls.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Human-readable application name (used as the API title).
APP_NAME=StudyOS API
# One of: development | testing | staging | production
ENVIRONMENT=development
# Enable verbose framework behaviour. Keep false in production.
DEBUG=false

# ── Server ───────────────────────────────────────────────────────────────────
# Interface and port the ASGI server binds to. Use 0.0.0.0 in containers.
HOST=127.0.0.1
PORT=8000
# Prefix applied to every API route (e.g. /api -> /api/tasks).
API_PREFIX=/api

# ── Database ─────────────────────────────────────────────────────────────────
# Full SQLAlchemy URL. Leave blank to use a local SQLite file under
# backend/database/studyos.db (development default).
# Examples:
#   sqlite:///./database/studyos.db
#   postgresql+psycopg://user:password@localhost:5432/studyos
DATABASE_URL=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Secret used to sign tokens once auth is added.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-change-me
# JWT signing algorithm.
ALGORITHM=HS256
# Access token lifetime in minutes (default: 1 day).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed browser origins. JSON array or comma-separated list.
# Example: http://localhost:5173,https://app.studyos.com
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────────
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Future configuration — declared and documented now, not yet consumed.
# Leave blank unless/until the corresponding feature is enabled.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Base URL for a local Ollama server, e.g. http://localhost:11434
OLLAMA_BASE_URL=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where uploaded files live. One of: local | s3 | ... (only `local` today).
STORAGE_PROVIDER=local

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
